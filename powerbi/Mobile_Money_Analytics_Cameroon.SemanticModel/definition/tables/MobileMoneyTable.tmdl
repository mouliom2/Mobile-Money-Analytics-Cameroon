table MobileMoneyTable
	lineageTag: f8bccf49-0a95-400c-88dd-eaab6c593a5f

	measure 'Nombre de Transactions' = COUNTROWS(MobileMoneyTable)
		formatString: #,##0
		lineageTag: 0771f4b8-4b9d-42bc-bf23-8694d3876815

	measure 'Transactions Réussies' = CALCULATE([Nombre de Transactions], MobileMoneyTable[Status] = "Success")
		formatString: #,##0
		lineageTag: 97e4e029-51dd-4605-9d4e-2dd9460d19d5

	measure 'Transactions Échouées' = CALCULATE([Nombre de Transactions], MobileMoneyTable[Status] = "Failed")
		formatString: #,##0
		lineageTag: e3036e8c-36e3-4d37-bf0e-1dc6970d559c

	measure 'Taux Succès' = DIVIDE([Transactions Réussies], [Nombre de Transactions], 0)
		formatString: 0.0%
		lineageTag: e0f5ce94-e8bc-4992-8287-d32922856242

	measure 'Taux Echec' = DIVIDE([Transactions Échouées], [Nombre de Transactions], 0)
		formatString: 0.0%
		lineageTag: 04004918-02a2-4497-a371-56103e03dab4

	measure 'Valeur Transactions' = CALCULATE(SUM(MobileMoneyTable[Amount_FCFA]), MobileMoneyTable[Status] = "Success")
		formatString: #,##0
		lineageTag: 1d4bf325-6c4f-479c-ada4-b53b83b075db

	measure 'Montant Moyen' = DIVIDE([Valeur Transactions], [Transactions Réussies], 0)
		formatString: #,##0
		lineageTag: 7c19cc24-aec1-489b-a953-2b47930efeca

	measure 'Frais Générés' = SUM(MobileMoneyTable[Fee_FCFA])
		formatString: #,##0
		lineageTag: 47088b9a-544b-4e10-85b8-625f4014e8c5

	measure 'Commissions Agents' = SUM(MobileMoneyTable[Agent_Commission_FCFA])
		formatString: #,##0
		lineageTag: 55d3f97e-171f-4c75-9bc6-3fbe9127906d

	measure 'Revenu Net' = SUM(MobileMoneyTable[Net_Revenue_FCFA])
		formatString: #,##0
		lineageTag: 14d3e458-1896-4a7b-9dac-c1553e91288f

	measure 'Frais / Transaction' = DIVIDE([Frais Générés], [Transactions Réussies], 0)
		formatString: #,##0
		lineageTag: 0424c067-55da-4c21-af73-dd10538555f3

	measure 'Clients Actifs' = DISTINCTCOUNT(MobileMoneyTable[Client_ID])
		formatString: #,##0
		lineageTag: a1454ea3-e129-4835-8930-8a3742f745e0

	measure 'Agents Actifs' = DISTINCTCOUNT(MobileMoneyTable[Agent_ID])
		formatString: #,##0
		lineageTag: 130ab981-8309-47f2-827f-8723ae06e82f

	measure 'Part MTN MoMo' = DIVIDE(CALCULATE([Valeur Transactions], MobileMoneyTable[Operator] = "MTN MoMo"), [Valeur Transactions], 0)
		formatString: 0.0%
		lineageTag: 9b9e6984-d1e0-44ff-aa0f-bfc4a2c7fb7b

	measure 'Part Orange Money' = DIVIDE(CALCULATE([Valeur Transactions], MobileMoneyTable[Operator] = "Orange Money"), [Valeur Transactions], 0)
		formatString: 0.0%
		lineageTag: da3f8bf2-f015-4b06-b5b7-8e57bee57e1b

